# Neon Postgres connection string for the guestbook.
# Vercel: Project → Settings → Environment Variables → DATABASE_URL
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Salt used to hash visitor IPs for guestbook rate limiting. Any long random string.
GUESTBOOK_SALT="change-me-to-a-long-random-string"
