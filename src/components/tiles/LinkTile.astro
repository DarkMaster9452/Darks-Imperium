---
/**
 * Dlaždica, ktorá vedie na podstránku: názov dole vľavo, šípka vpravo hore
 * a voliteľná grafika na pozadí.
 */
import Panel from "../Panel.astro";

interface Props {
  href: string;
  title: string;
  class?: string;
}
const { href, title, class: className = "" } = Astro.props;
---

<Panel href={href} label={title} class:list={["link-tile", className]} pad="0">
  <div class="art"><slot /></div>

  <svg class="tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 17 17 7"></path>
    <path d="M8 7h9v9"></path>
  </svg>

  <h2 class="label">{title}</h2>
</Panel>

<style>
  .link-tile :global(.panel-in) {
    position: relative;
    display: grid;
    align-content: end; /* nadpis drží pri spodnej hrane, nad grafikou */
    min-height: 116px;
    padding: 0;
    overflow: hidden;
  }

  .art {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .label {
    position: relative;
    align-self: end;
    padding: 14px 16px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 12px var(--bg);
  }
</style>
