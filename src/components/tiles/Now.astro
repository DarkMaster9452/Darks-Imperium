---
import Panel from "../Panel.astro";
import { useTranslations, localizePath, type Lang } from "../../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

/** Dátum poslednej úpravy tejto dlaždice — meň spolu s textom nowText. */
const updated = new Date("2026-08-31");
const stamp = new Intl.DateTimeFormat(lang === "sk" ? "sk-SK" : "en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(updated);
---

<Panel href={localizePath("/now", lang)} label={t("nowTitle")} class="now" pad="18px">
  <div class="head">
    <h2 class="tile-title">{t("nowTitle")}</h2>
    <p class="stamp">
      {stamp}
      <span class="dot" aria-hidden="true"></span>
    </p>
  </div>

  <p class="text">{t("nowText")}</p>

  <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 17 17 7"></path>
    <path d="M8 7h9v9"></path>
  </svg>
</Panel>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    padding-right: 20px;
  }

  .arrow {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 14px;
    height: 14px;
    color: var(--text-2);
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  :global(.panel:hover) .arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .stamp {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
    white-space: nowrap;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    transition: background var(--dur) var(--ease);
  }

  .text {
    font-size: 13px;
    color: var(--text-2);
  }
</style>
