---
import LinkTile from "./LinkTile.astro";
import { projects } from "../../data/projects";
import { useTranslations, localizePath, type Lang } from "../../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<LinkTile href={localizePath("/work", lang)} title={t("workTile")} class="work-tile">
  <ul class="shots">
    {
      projects.map((p) => (
        <li>
          <img src={p.img} alt="" width="220" height="140" loading="lazy" decoding="async" />
        </li>
      ))
    }
  </ul>
</LinkTile>

<style>
  .shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 6px;
    height: 100%;
    padding: 10px 10px 34px;
  }

  .shots li { overflow: hidden; border-radius: 3px; }

  /* V pokoji stlmené ako na pôvodnom webe, pri hoveri nabehnú do plnej farby. */
  .shots img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.5) brightness(0.55);
    transition: filter var(--dur) var(--ease);
  }

  .work-tile:hover .shots img { filter: saturate(1) brightness(0.9); }

  /* Prekrytie, aby bol nadpis čitateľný nad screenshotmi. */
  .shots::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: linear-gradient(to top, var(--panel) 25%, transparent);
  }
</style>
