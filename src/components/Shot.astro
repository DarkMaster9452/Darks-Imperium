---
/**
 * Screenshot v ráme okna. Obrázok sa nikdy neorezáva — box má pomer 16:10
 * a obrázok sa doň zmestí celý, prípadné pásy po stranách splynú s plochou.
 */
interface Props {
  src: string;
  alt?: string;
  /** Popisok v lište okna — doména alebo názov programu. */
  label?: string;
  /** Úvodný záber sa načíta hneď, galéria až pri rolovaní. */
  eager?: boolean;
  class?: string;
}

const { src, alt = "", label, eager = false, class: className = "" } = Astro.props;
---

<div class:list={["shot", className]}>
  <div class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {label && <span class="label">{label}</span>}
  </div>
  <div class="frame">
    <img
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : undefined}
    />
  </div>
</div>

<style>
  .shot {
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.4);
    transition: border-color var(--dur) var(--ease);
  }
  .shot:hover { border-color: var(--accent-line); }

  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
    height: 28px;
    background: var(--panel-3);
    border-bottom: 1px solid var(--line);
  }

  .dots { display: flex; gap: 5px; }
  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dots i:first-child { background: var(--accent); opacity: 0.8; }

  .label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Pevný pomer drží rozloženie na mieste ešte pred načítaním obrázka. */
  .frame {
    aspect-ratio: 16 / 10;
    background: var(--panel-2);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
