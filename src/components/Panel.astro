---
/**
 * Panel — základná karta celej dosky: tmavá plocha, hairline rámik, pri hoveri
 * sa rámik prefarbí na akcent. Rohy nesú štyri malé „ozuby", ktoré nadväzujú
 * na skosenie z pôvodného loga MS.
 */
interface Props {
  as?: "div" | "section" | "article" | "aside" | "li";
  href?: string;
  label?: string;
  class?: string;
  pad?: string;
  interactive?: boolean;
}

const {
  as = "div",
  href,
  label,
  class: className = "",
  pad = "20px",
  interactive = Boolean(Astro.props.href),
} = Astro.props;

const Tag = href ? "a" : as;
const attrs = href ? { href, "aria-label": label, "data-astro-prefetch": "hover" } : {};
---

<Tag
  class:list={["panel", { "is-interactive": interactive }, className]}
  style={`--pad:${pad}`}
  {...attrs}
>
  <span class="nub nub-tl" aria-hidden="true"></span>
  <span class="nub nub-br" aria-hidden="true"></span>
  <div class="panel-in"><slot /></div>
</Tag>

<style>
  .panel {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.35);
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .panel-in {
    position: relative;
    height: 100%;
    padding: var(--pad);
  }

  /* Ozuby v rohoch — jemný odkaz na skosenie v logu. */
  .nub {
    position: absolute;
    z-index: 2;
    width: 7px;
    height: 7px;
    border: 0 solid var(--line);
    pointer-events: none;
    transition: border-color var(--dur) var(--ease);
  }
  .nub-tl {
    top: 5px;
    left: 5px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .nub-br {
    right: 5px;
    bottom: 5px;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  /* Rámik sa rozsvieti na každej karte, nielen na klikateľnej — doska tak
     reaguje celá. */
  .panel:hover,
  .panel:focus-visible {
    border-color: var(--accent);
  }
  .panel:hover .nub,
  .panel:focus-visible .nub {
    border-color: var(--accent);
  }
  .panel.is-interactive:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  a.panel { color: inherit; }
  a.panel:hover { color: inherit; }
</style>
