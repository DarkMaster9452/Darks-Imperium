---
/**
 * Rotujúci avatar — sprite sheet 6×4 (24 snímok, jedna 414×390 px), prehrávaný
 * dvoma CSS animáciami: rýchlejšia prechádza stĺpce v riadku, pomalšia posúva
 * na ďalší riadok. Spolu prejdú celú otáčku.
 *
 * Sheet sa vyberá premennou --avatar-sheet (tokens.css) podľa akcentu, takže
 * postava má vždy farbu témy.
 */
interface Props {
  alt: string;
  class?: string;
  /** Dĺžka jednej otáčky. */
  duration?: string;
}

const { alt, class: className = "", duration = "4s" } = Astro.props;

const COLS = 6;
const ROWS = 4;
const FRAME_RATIO = 414 / 390;
---

<div
  class:list={["avatar", className]}
  role="img"
  aria-label={alt}
  style={`--cols:${COLS};--rows:${ROWS};--spin:${duration};--ratio:${FRAME_RATIO}`}
>
  <span class="sprite"></span>
</div>

<style>
  .avatar {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 180px;
  }

  .sprite {
    display: block;
    height: var(--sprite-h, 240px);
    width: calc(var(--sprite-h, 240px) * var(--ratio));

    background-image: var(--avatar-sheet);
    background-repeat: no-repeat;
    /* 6×4 mriežka: pozadie roztiahneme tak, aby jedna bunka vyplnila prvok. */
    background-size: calc(var(--cols) * 100%) calc(var(--rows) * 100%);
    background-position: 0 0;

    filter: drop-shadow(0 12px 28px rgb(0 0 0 / 0.45));
    /* Percentuálny background-position sa počíta z rozdielu veľkostí, nie z
       šírky prvku: pri pozadí 6× širšom prejde 0 % → 100 % presne všetkých šesť
       stĺpcov. jump-none zaručí, že sa trafí aj prvá aj posledná snímka. */
    animation:
      spin-cols calc(var(--spin) / var(--rows)) steps(var(--cols), jump-none) infinite,
      spin-rows var(--spin) steps(var(--rows), jump-none) infinite;
  }

  @keyframes spin-cols {
    from { background-position-x: 0%; }
    to { background-position-x: 100%; }
  }
  @keyframes spin-rows {
    from { background-position-y: 0%; }
    to { background-position-y: 100%; }
  }

  @media (max-width: 1100px) {
    .avatar { --sprite-h: 190px; }
  }

  /* Na úzkych obrazovkách je hero jednostĺpcový — avatar by tam len tlačil
     text dole, tak ho schováme. */
  @media (max-width: 760px) {
    .avatar { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sprite { animation: none; }
  }
</style>
