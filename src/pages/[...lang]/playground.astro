---
import SubPage from "../../layouts/SubPage.astro";
import { langStaticPaths, useTranslations, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<SubPage lang={lang} path="/playground" title={t("pgTitle")} subtitle={t("pgSub")}>
  <div class="wrap">
    <canvas data-playground width="960" height="480" aria-label={t("pgSub")} role="img"></canvas>
    <p class="hint">{t("pgHint")}</p>
  </div>
</SubPage>

<style>
  .wrap {
    max-width: 960px;
    margin-inline: auto;
  }

  canvas {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    background: var(--panel);
    border: 1px solid var(--line);
    cursor: crosshair;
    touch-action: none;
  }

  .hint {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    text-align: center;
    color: var(--muted);
  }
</style>

<script>
  /**
   * Pixelové pole, ktoré reaguje na kurzor: každá bunka sa rozsvieti podľa
   * vzdialenosti od myši. Farbu berie z --accent, takže sedí s témou.
   */
  function startPlayground() {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-playground]");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cell = 16;
    let mouse = { x: canvas.width / 2, y: canvas.height / 2 };
    let raf = 0;

    const accent = () =>
      getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#e11d48";

    const toCanvas = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      mouse = {
        x: ((e.clientX - r.left) / r.width) * canvas.width,
        y: ((e.clientY - r.top) / r.height) * canvas.height,
      };
    };

    const draw = () => {
      const color = accent();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = color;

      const reach = cell * 9;
      for (let y = 0; y < canvas.height; y += cell) {
        for (let x = 0; x < canvas.width; x += cell) {
          const dx = x + cell / 2 - mouse.x;
          const dy = y + cell / 2 - mouse.y;
          const dist = Math.hypot(dx, dy);
          if (dist > reach) continue;

          const strength = 1 - dist / reach;
          const size = Math.max(1, Math.round(cell * strength * 0.85));
          ctx.globalAlpha = 0.15 + strength * 0.85;
          ctx.fillRect(
            x + Math.round((cell - size) / 2),
            y + Math.round((cell - size) / 2),
            size,
            size,
          );
        }
      }
      ctx.globalAlpha = 1;
    };

    const loop = () => {
      draw();
      raf = requestAnimationFrame(loop);
    };

    canvas.addEventListener("pointermove", toCanvas);
    canvas.addEventListener("click", () => {
      cell = cell === 16 ? 26 : cell === 26 ? 10 : 16;
      if (reduced) draw();
    });

    if (reduced) draw();
    else raf = requestAnimationFrame(loop);

    document.addEventListener("astro:before-swap", () => cancelAnimationFrame(raf), { once: true });
  }

  startPlayground();
  document.addEventListener("astro:page-load", startPlayground);
</script>
