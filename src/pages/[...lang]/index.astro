---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/tiles/Hero.astro";
import Stack from "../../components/tiles/Stack.astro";
import Contact from "../../components/tiles/Contact.astro";
import Clock from "../../components/tiles/Clock.astro";
import Now from "../../components/tiles/Now.astro";
import WorkTile from "../../components/tiles/WorkTile.astro";
import CvTile from "../../components/tiles/CvTile.astro";
import GuestbookTile from "../../components/tiles/GuestbookTile.astro";
import Accent from "../../components/tiles/Accent.astro";
import Footer from "../../components/tiles/Footer.astro";
import { langStaticPaths, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
---

<Base lang={lang} path="/">
  <div class="board-grid">
    <div class="area-hero"><Hero lang={lang} /></div>
    <div class="area-stack"><Stack lang={lang} /></div>

    <div class="area-contact"><Contact lang={lang} /></div>
    <div class="area-clock"><Clock lang={lang} /></div>
    <div class="area-work"><WorkTile lang={lang} /></div>
    <div class="area-now"><Now lang={lang} /></div>
    <div class="area-cv"><CvTile lang={lang} /></div>
    <div class="area-guest"><GuestbookTile lang={lang} /></div>
    <div class="area-accent"><Accent lang={lang} /></div>
    <div class="area-footer"><Footer lang={lang} /></div>
  </div>
</Base>

<style>
  /* Mozaika. Na veľkých obrazovkách má doska pevných 8 riadkov a zmestí sa na
     jednu obrazovku — presne ako referencia; nižšie sa preskladá do stĺpcov. */
  .board-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 0.8fr);
    gap: var(--gap);
    align-items: stretch;
    grid-template-areas:
      "hero    hero  hero  stack"
      "hero    hero  hero  stack"
      "hero    hero  hero  stack"
      "hero    hero  hero  stack"
      "contact clock work  stack"
      "contact clock work  stack"
      "contact cv    now   accent"
      "contact cv    guest footer";
  }

  @media (min-width: 1200px) {
    .board-grid {
      height: max(calc(100dvh - 96px), 780px);
      grid-template-rows: repeat(8, minmax(0, 1fr));
    }
  }

  .area-hero { grid-area: hero; }
  .area-stack { grid-area: stack; }
  .area-contact { grid-area: contact; }
  .area-clock { grid-area: clock; }
  .area-work { grid-area: work; }
  .area-now { grid-area: now; }
  .area-cv { grid-area: cv; }
  .area-guest { grid-area: guest; }
  .area-accent { grid-area: accent; }
  .area-footer { grid-area: footer; }

  .board-grid > * { min-width: 0; }
  .board-grid > * > :global(.panel) { height: 100%; }

  @media (max-width: 1000px) {
    .board-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "hero    hero"
        "stack   stack"
        "contact clock"
        "work    now"
        "cv      guest"
        "accent  footer";
    }
  }

  @media (max-width: 620px) {
    .board-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "hero"
        "clock"
        "work"
        "now"
        "cv"
        "guest"
        "stack"
        "contact"
        "accent"
        "footer";
    }
  }
</style>
