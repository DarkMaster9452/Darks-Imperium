---
import SubPage from "../../../layouts/SubPage.astro";
import Panel from "../../../components/Panel.astro";
import { projects } from "../../../data/projects";
import { langStaticPaths, useTranslations, localizePath, type Lang } from "../../../i18n/utils";

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const services = [
  { h: t("svc1H"), p: t("svc1P") },
  { h: t("svc2H"), p: t("svc2P") },
  { h: t("svc3H"), p: t("svc3P") },
];
---

<SubPage lang={lang} path="/work" title={t("workTitle")} subtitle={t("workIntro")}>
  <ul class="grid">
    {
      projects.map((project) => {
        const c = project[lang];
        return (
          <li>
            <Panel href={localizePath(`/work/${project.slug}`, lang)} label={c.title} pad="0">
              <figure>
                <img src={project.img} alt="" width="760" height="480" loading="lazy" decoding="async" />
              </figure>

              <div class="body">
                <div class="row">
                  <h2>{c.title}</h2>
                  <span class:list={["badge", { concept: project.concept }]}>
                    {project.concept ? t("labelConcept") : t("labelLive")}
                  </span>
                </div>
                <p>{c.summary}</p>
                <ul class="tags">
                  {project.stack.slice(0, 4).map((s) => <li>{s}</li>)}
                </ul>
              </div>
            </Panel>
          </li>
        );
      })
    }
  </ul>

  <section class="services">
    <h2 class="services-title">{t("servicesTitle")}</h2>
    <div class="services-grid">
      {
        services.map((s) => (
          <Panel pad="20px">
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </Panel>
        ))
      }
    </div>
  </section>

  <p class="all">
    <a href="https://github.com/DarkMaster9452?tab=repositories" target="_blank" rel="noopener">
      {t("workAll")} →
    </a>
  </p>
</SubPage>

<style>
  /* Štyri projekty — pri 1152 px to vyjde na mriežku 2×2. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--gap);
  }

  .grid > li > :global(.panel) { height: 100%; }
  .grid :global(.panel-in) {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  /* Pevná výška náhľadu — screenshoty sú rôzne vysoké, orežeme ich zhora. */
  figure {
    height: 220px;
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: saturate(0.62) brightness(0.72);
    transition: filter var(--dur) var(--ease);
  }
  :global(.panel:hover) img { filter: saturate(1) brightness(0.95); }

  .body { padding: 16px 18px 18px; }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
  }

  h2 { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }

  .badge {
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-line);
    border-radius: 999px;
  }
  .badge.concept { color: var(--muted); border-color: var(--line); }

  .body > p { font-size: 13px; color: var(--text-2); }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 12px;
  }
  .tags li {
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
    background: var(--panel-2);
    border-radius: 999px;
  }

  .services { margin-top: 48px; }

  .services-title {
    margin-bottom: 14px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap);
  }
  .services-grid h3 { margin-bottom: 6px; font-size: 14px; font-weight: 600; }
  .services-grid p { font-size: 13px; color: var(--text-2); }

  .all {
    margin-top: 32px;
    font-size: 13px;
    text-align: center;
    color: var(--text-2);
  }
</style>
