---
import SubPage from "../../../layouts/SubPage.astro";
import Panel from "../../../components/Panel.astro";
import { projects } from "../../../data/projects";
import { langStaticPaths, useTranslations, localizePath, type Lang } from "../../../i18n/utils";

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const featured = projects.find((p) => p.featured);
const rest = projects.filter((p) => !p.featured);

const services = [
  { h: t("svc1H"), p: t("svc1P") },
  { h: t("svc2H"), p: t("svc2P") },
  { h: t("svc3H"), p: t("svc3P") },
];

function statusLabel(status: (typeof projects)[number]["status"]) {
  if (status === "product") return t("labelProduct");
  if (status === "concept") return t("labelConcept");
  return t("labelLive");
}
---

<SubPage lang={lang} path="/work" title={t("workTitle")} subtitle={t("workIntro")}>
  {
    featured && (
      <Panel
        href={localizePath(`/work/${featured.slug}`, lang)}
        label={featured[lang].title}
        pad="0"
        class="feature"
      >
        <div class="feature-in">
          <figure class="feature-shot">
            <img
              src={featured.img}
              alt=""
              width="1600"
              height="1000"
              fetchpriority="high"
              decoding="async"
            />
          </figure>

          <div class="feature-body">
            <p class="eyebrow feature-eyebrow">{t("featuredLabel")}</p>
            <div class="row">
              <h2>{featured[lang].title}</h2>
              <span class="badge product">{statusLabel(featured.status)}</span>
            </div>
            <p class="summary">{featured[lang].summary}</p>
            <ul class="tags">
              {featured.stack.slice(0, 5).map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <span class="more">
              {t("caseOpen")} <span aria-hidden="true">→</span>
            </span>
          </div>
        </div>
      </Panel>
    )
  }

  <ul class="grid">
    {
      rest.map((project) => {
        const c = project[lang];
        return (
          <li>
            <Panel href={localizePath(`/work/${project.slug}`, lang)} label={c.title} pad="0">
              <figure>
                <img src={project.img} alt="" width="760" height="480" loading="lazy" decoding="async" />
              </figure>

              <div class="body">
                <div class="row">
                  <h2>{c.title}</h2>
                  <span class:list={["badge", { concept: project.status === "concept" }]}>
                    {statusLabel(project.status)}
                  </span>
                </div>
                <p class="summary">{c.summary}</p>
                <ul class="tags">
                  {project.stack.slice(0, 4).map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </Panel>
          </li>
        );
      })
    }
  </ul>

  <section class="services">
    <h2 class="services-title">{t("servicesTitle")}</h2>
    <div class="services-grid">
      {
        services.map((s) => (
          <Panel pad="20px">
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </Panel>
        ))
      }
    </div>
  </section>

  <p class="all">
    <a href="https://github.com/DarkMaster9452?tab=repositories" target="_blank" rel="noopener">
      {t("workAll")} →
    </a>
  </p>
</SubPage>

<style>
  /* ── hlavný projekt cez celú šírku ──────────────────────────────────── */
  .feature { margin-bottom: var(--gap); }
  .feature :global(.panel-in) { padding: 0; }

  .feature-in {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .feature-shot {
    overflow: hidden;
    background: var(--panel-2);
    border-right: 1px solid var(--line);
  }
  .feature-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    filter: saturate(0.72) brightness(0.82);
    transition: filter var(--dur) var(--ease);
  }
  .feature:hover .feature-shot img { filter: none; }

  .feature-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(20px, 3vw, 30px);
  }
  .feature-eyebrow {
    margin-bottom: 12px;
    color: var(--accent);
    transition: color var(--dur) var(--ease);
  }
  .feature-body h2 { font-size: clamp(20px, 2.4vw, 26px); }
  .feature-body .summary { font-size: 14px; line-height: 1.7; }

  .more {
    margin-top: auto;
    padding-top: 18px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    transition: color var(--dur) var(--ease);
  }

  @media (max-width: 860px) {
    .feature-in { grid-template-columns: minmax(0, 1fr); }
    .feature-shot {
      height: 220px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  /* ── ostatné projekty ───────────────────────────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: var(--gap);
  }

  .grid > li > :global(.panel) { height: 100%; }
  .grid :global(.panel-in) {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  /* Náhľad sa nikdy neorezáva — celý screenshot v pomere 16:10. */
  figure {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--panel-2);
    border-bottom: 1px solid var(--line);
  }

  .grid img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: saturate(0.72) brightness(0.8);
    transition: filter var(--dur) var(--ease);
  }
  :global(.panel:hover) .grid img,
  .grid :global(.panel:hover) img { filter: none; }

  .body { padding: 16px 18px 18px; }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }

  h2 { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }

  .badge {
    flex: none;
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-line);
    border-radius: 999px;
  }
  .badge.concept { color: var(--muted); border-color: var(--line); }
  .badge.product {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }

  .summary { font-size: 13px; color: var(--text-2); }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 12px;
  }
  .tags li {
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
    background: var(--panel-2);
    border-radius: 999px;
  }

  .services { margin-top: 48px; }

  .services-title {
    margin-bottom: 14px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--gap);
  }
  .services-grid h3 { margin-bottom: 6px; font-size: 14px; font-weight: 600; }
  .services-grid p { font-size: 13px; color: var(--text-2); }

  .all {
    margin-top: 32px;
    font-size: 13px;
    text-align: center;
    color: var(--text-2);
  }
</style>
